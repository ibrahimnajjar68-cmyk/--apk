{
  "appId": "com.hamzanajjar.app",
  "appName": "محول الموقع إلي تطبيق",
  "webDir": "www",
  "server": {
    "url": "https://smart-app-workbench.lovable.app/",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#000000",
    "webContentsDebuggingEnabled": false,
    "captureInput": true,
    "useLegacyBridge": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "backgroundColor": "#000000",
      "launchAutoHide": true,
      "launchShowDuration": 1200
    }
  }
}